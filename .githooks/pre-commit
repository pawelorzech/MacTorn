#!/usr/bin/env bash
#
# MacTorn pre-commit hook: block commits that contain secrets.
# Installed via `make hooks` (sets core.hooksPath to .githooks).
# Scans only what is staged, using the repo's .gitleaks.toml.

set -euo pipefail

# Fail closed. A missing scanner used to `exit 0` with a warning, so on a machine
# where gitleaks was never installed (or was removed) `make hooks` left a hook that
# looked installed but checked nothing — and the warning scrolls past unread.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "🛑 Commit blocked: gitleaks is not installed, so staged changes were NOT scanned."
  echo "    • Install it:      brew install gitleaks"
  echo "    • Or skip once:    git commit --no-verify   (you take responsibility)"
  exit 1
fi

if ! gitleaks git --staged --no-banner --redact --config .gitleaks.toml; then
  echo ""
  echo "🛑 Commit blocked: potential secret detected (see above)."
  echo "   • Remove the secret, or"
  echo "   • If it's a false positive, allowlist it in .gitleaks.toml, or"
  echo "   • Bypass once with: git commit --no-verify"
  exit 1
fi
